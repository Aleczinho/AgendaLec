// Schema do AgendaLec para o Prisma ORM.
//
// Os nomes dos models e dos campos são IGUAIS aos nomes das tabelas e colunas
// (snake_case). Isso é proposital: o front conversa com /api/db usando os nomes
// das colunas, então a API não precisa de nenhuma camada de tradução.
//
// O que o Prisma não consegue descrever fica só na migration SQL
// (prisma/migrations/*/migration.sql): CHECKs, o índice único em lower(email)
// e as funções PL/pgSQL antigas.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String
  password_hash String
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  profile            profiles?
  calendars          calendars[]
  events             events[]
  holiday_dates      holiday_dates[]
  routine_rules      routine_rules[]
  routine_exceptions routine_exceptions[]
}

model profiles {
  id           String    @id @db.Uuid
  display_name String?
  timezone     String?   @default("America/Fortaleza")
  preferences  Json?     @default("{}")
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @default(now()) @db.Timestamptz(6)

  user users @relation(fields: [id], references: [id], onDelete: Cascade)
}

model calendars {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid
  name        String
  description String?
  color       String?   @default("#3B82F6")
  is_active   Boolean?  @default(true)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)

  user          users           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  events        events[]
  routine_rules routine_rules[]

  @@index([user_id], map: "calendars_user_idx")
}

model events {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String    @db.Uuid
  calendar_id     String?   @db.Uuid
  title           String
  description     String?
  category        String?
  start_at        DateTime  @db.Timestamptz(6)
  end_at          DateTime? @db.Timestamptz(6)
  all_day         Boolean?  @default(false)
  location        String?
  color           String?
  status          String?   @default("pending")
  notes           String?
  recurrence_rule String?
  certainty       String    @default("confirmed")
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)

  user     users      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  calendar calendars? @relation(fields: [calendar_id], references: [id], onDelete: SetNull)

  @@index([user_id, start_at], map: "events_user_start_idx")
}

// user_id NULL = feriado global, visível a todos os usuários
model holiday_dates {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String?   @db.Uuid
  date                DateTime  @db.Date
  name                String
  scope               String?
  municipality        String?
  state               String?
  source_url          String?
  verification_status String?   @default("pending")
  seed_key            String?
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  updated_at          DateTime? @default(now()) @db.Timestamptz(6)

  user users? @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, seed_key], map: "holiday_dates_seed_key_unique")
  @@index([user_id, date], map: "holiday_dates_user_date_idx")
}

model routine_rules {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                   String    @db.Uuid
  seed_key                  String?
  title                     String
  description               String?
  category                  String    @default("rotina")
  calendar_id               String?   @db.Uuid
  weekdays                  Int[]     @db.SmallInt
  start_time                DateTime? @db.Time(6)
  end_time                  DateTime? @db.Time(6)
  start_time_earliest       DateTime? @db.Time(6)
  start_time_latest         DateTime? @db.Time(6)
  end_time_earliest         DateTime? @db.Time(6)
  end_time_latest           DateTime? @db.Time(6)
  schedule_type             String
  is_approximate            Boolean   @default(false)
  recurrence_interval_weeks Int       @default(1)
  recurrence_anchor_date    DateTime? @db.Date
  first_confirmed_on        DateTime? @db.Date
  confirmation_required     Boolean   @default(false)
  valid_from                DateTime  @db.Date
  valid_until               DateTime? @db.Date
  timezone                  String    @default("America/Fortaleza")
  is_active                 Boolean   @default(true)
  created_at                DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                DateTime  @default(now()) @db.Timestamptz(6)

  user               users                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  calendar           calendars?           @relation(fields: [calendar_id], references: [id], onDelete: SetNull)
  routine_exceptions routine_exceptions[]

  @@unique([user_id, seed_key], map: "routine_rules_seed_key_unique")
  @@unique([id, user_id], map: "routine_rules_owner_unique")
  @@index([user_id, is_active, valid_from], map: "routine_rules_user_active_idx")
}

model routine_exceptions {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routine_rule_id       String    @db.Uuid
  user_id               String    @db.Uuid
  occurrence_date       DateTime  @db.Date
  action                String
  overridden_title      String?
  overridden_start_time DateTime? @db.Time(6)
  overridden_end_time   DateTime? @db.Time(6)
  notes                 String?
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @default(now()) @db.Timestamptz(6)

  user users          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  rule routine_rules  @relation(fields: [routine_rule_id, user_id], references: [id, user_id], onDelete: Cascade, map: "routine_exceptions_rule_owner_fk")

  @@unique([routine_rule_id, occurrence_date], map: "routine_exceptions_rule_date_unique")
  @@index([user_id, occurrence_date], map: "routine_exceptions_user_date_idx")
}
