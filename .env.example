# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=troque-esta-senha
DB_NAME=agendalec
DB_SSL=false

# Better Auth
# URL pública onde o navegador acessa o AgendaLec (sem /api).
BETTER_AUTH_URL=http://localhost:8080
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=COLOQUE_UM_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_CARACTERES
# Origens adicionais do frontend, separadas por vírgula. Em mesma origem, pode ficar vazio.
BETTER_AUTH_TRUSTED_ORIGINS=

# API / cadastro
API_PORT=3001
ALLOW_REGISTRATION=false
DB_AUTO_MIGRATE=true
