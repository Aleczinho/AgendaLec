# =====================================================================
# AgendaLec — configuração (copie para .env e ajuste)
#   cp .env.example .env
# O .env fica na raiz do projeto e é lido pela API (server/) e pelo Docker.
# NUNCA publique o .env: ele contém a senha do banco.
# =====================================================================

# ---------- Conexão com o PostgreSQL (seu servidor) ----------
DB_HOST=192.168.0.10
DB_PORT=5432
DB_USER=agendalec
DB_PASSWORD=troque-esta-senha
DB_NAME=agendalec
# false | true (exige certificado válido) | no-verify (TLS sem validar certificado)
DB_SSL=false

# Alternativa: uma única URL (tem prioridade sobre DB_HOST/DB_PORT/...).
# Se a senha tiver caracteres especiais (@ : / # %), use codificação de URL.
# DATABASE_URL=postgresql://agendalec:senha@192.168.0.10:5432/agendalec

# Cria/atualiza as tabelas automaticamente quando a API inicia.
DB_AUTO_MIGRATE=true

# ---------- API ----------
API_PORT=3001
# Segredo que assina os logins (mínimo 32 caracteres). Gere com: openssl rand -hex 48
JWT_SECRET=
# Validade do login: 7d, 12h, 30d...
JWT_EXPIRES_IN=7d
# true = qualquer pessoa pode criar conta na tela de cadastro.
# Crie sua conta e depois coloque false (novas contas: npm run user:create -- email senha).
ALLOW_REGISTRATION=true

# ---------- Front-end / Docker ----------
# Porta publicada pelo Docker (nginx + API juntos em http://servidor:8080).
APP_PORT=8080
# Só se a API ficar em OUTRO endereço que o site (ex.: https://api.exemplo.com/api).
# Deixe vazio para usar o mesmo endereço do site (/api).
# VITE_API_URL=
# Origem(ns) autorizada(s) a chamar a API, apenas se VITE_API_URL apontar para outro domínio.
# CORS_ORIGIN=https://agenda.exemplo.com
